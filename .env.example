# Zabron — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to source control.

# Required — your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Required — your Discord application's client ID
CLIENT_ID=

# Optional — database file path. Defaults to ./data/zabron.sqlite
DATABASE_PATH=./data/zabron.sqlite

# Optional — comma-separated list of guild IDs for instant slash command registration.
# Leave empty to register global commands.
DEV_GUILDS=

# Optional — log level (trace|debug|info|warn|error). Defaults to info.
LOG_LEVEL=info

# Optional — owner user IDs (comma-separated). Used for owner-only escape commands.
OWNER_IDS=

# -------- Optional AI configuration (Zabron core works without AI) --------
AI_PROVIDER=openai          # openai | anthropic | none
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=