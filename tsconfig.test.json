{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "noEmit": true,
    "outDir": "./.test-build",
    "module": "node16",
    "moduleResolution": "node16",
    "noImplicitAny": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", ".test-build"]
}